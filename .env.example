MODEL_BACKEND=airllm
GENERAL_MODEL=Qwen/Qwen3-0.6B
CODING_MODEL=Qwen/Qwen2.5-Coder-1.5B
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_GENERAL_MODEL=qwen3:0.6b
OLLAMA_CODING_MODEL=qwen2.5-coder:1.5b
LOW_RAM_MODE=true
RAM_SOFT_LIMIT_GB=3.5
RAM_CRITICAL_LIMIT_GB=3.85
MAX_CONTEXT_TOKENS=768
MAX_NEW_TOKENS=128
MAX_SUBAGENTS=4
MAX_PARALLEL_AGENTS=2
MAX_AGENT_DEPTH=2
CACHE_MAX_ENTRIES=128
CACHE_MAX_BYTES=4194304
PERSISTENT_CACHE_MAX_BYTES=16777216
AIRLLM_MODEL_DIR=data/models
AIRLLM_UNLOAD_IDLE_SECONDS=300
PYTHON_TIMEOUT=120
TERMINAL_TIMEOUT=30
WEB_TIMEOUT=12
TRUSTED_PATHS=scripts${PATHSEP}projects
OPENAI_ENABLED=false
OPENAI_MODEL=gpt-5.6-luna
